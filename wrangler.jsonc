{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modify-construction",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "modify-construction-db",
      "database_id": "f3b52a1b-41f1-41a9-901f-da864f6b6aad"
    }
  ]
}
